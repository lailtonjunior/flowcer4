# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Conta admin inicial que será criada (apenas para referência)
ADMIN_INITIAL_EMAIL="admin@cer4.local"
ADMIN_INITIAL_PASSWORD="ChangeMe!2026"

# ====================================================
# Banco de Dados Externo SIGH (PostgreSQL)
# Utilizado para pesquisar pacientes em tempo real
# ====================================================
SIGH_DB_HOST="192.168.68.101"
SIGH_DB_PORT="5432"
SIGH_DB_USER="seu_usuario_sigh"
SIGH_DB_PASSWORD="sua_senha_sigh"
SIGH_DB_NAME="bd0553"
ADMIN_NAME=Administrador CER4

# App
NEXT_PUBLIC_APP_NAME=Agenda CER4
NEXT_PUBLIC_TIMEZONE=America/Sao_Paulo

# ====================================================
# Search Engine Local (Meilisearch via Docker)
# ====================================================
NEXT_PUBLIC_MEILISEARCH_URL="http://localhost:7700"
MEILI_MASTER_KEY="your-32-byte-hex-string"
CRON_SECRET="your-32-byte-hex-string"
# ====================================================
# Meilisearch (motor de busca local)
# Suba via: docker compose up -d
# ====================================================
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=troque-por-chave-aleatoria-com-pelo-menos-16-chars
MEILI_PATIENTS_INDEX=patients

# ====================================================
# Cron (sync periódico SIGH → Meilisearch)
# Use no header: Authorization: Bearer <CRON_SECRET>
# ====================================================
CRON_SECRET=outro-segredo-aleatorio-de-32-chars
